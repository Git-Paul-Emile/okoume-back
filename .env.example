# Copier ce fichier en .env et remplir les valeurs. Le fichier .env n'est jamais versionné.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Jetons d'accès : chaîne aléatoire de 32 caractères au moins (node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))")
JWT_ACCESS_SECRET=a-generer
APP_URL=http://localhost:5173
# Adresse publique de l'API, pour les liens de partage avec aperçu (facultative)
API_PUBLIC_URL=http://localhost:3000
EMAIL_FROM=Okoumé <no-reply@okoume.ga>

# Resend : clé d'API « Sending access », domaine d'EMAIL_FROM vérifié dans la console Resend.
# Vide en développement : les e-mails (et leurs codes) sont écrits dans les logs. Obligatoire en staging et production.
RESEND_API_KEY=

# Notifications push : générer les clés une fois avec « npx web-push generate-vapid-keys ».
# Les trois valeurs vont ensemble, contact compris (exemple : mailto:contact@okoume.ga).
# Laisser les trois vides pour désactiver les notifications push (les e-mails restent le canal de référence).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Cloudinary (images) : console Cloudinary > Settings > API Keys. Les trois valeurs vont ensemble.
# Vide : l'envoi d'images est indisponible, les adresses HTTPS saisies à la main restent possibles.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Vérification des annonces par IA (console Anthropic > API Keys). Lue par le worker seulement.
# Vide : chaque annonce soumise attend une décision humaine. Modèle modifiable (coût et qualité).
ANTHROPIC_API_KEY=
LISTING_REVIEW_MODEL=claude-opus-5-5
# Négociateur du tchat : même clé, modèle réglable séparément
CHAT_MODEL=claude-opus-5-5

# Gemini (Google AI Studio > API keys) : utilisé à la place d'Anthropic dès que la clé est renseignée,
# pour la vérification des annonces et le tchat. Lue par le worker seulement.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Mot de passe commun des comptes de démonstration créés par « npm run db:seed » (12 caractères au moins).
# Jamais utilisé en production : le seed n'y charge que les données de référence.
SEED_DEMO_PASSWORD=

# Délais des retours en jours : demande après livraison, puis réouverture d'un dossier refusé
RETURN_WINDOW_DAYS=14
RETURN_REOPEN_DAYS=14

# Limitation de débit par adresse IP sur 15 minutes : boutique et API publique, puis back-office (compteur à part)
RATE_LIMIT_API_MAX=300
RATE_LIMIT_STAFF_MAX=3000

# Origines autorisées à appeler l'API (front), séparées par des virgules
CORS_ORIGINS=http://localhost:5173

# Domaine commun au site et à l'API en production (.okoume.ga), pour que le site lise le cookie anti-CSRF.
# Laisser vide en local : le front et l'API sont alors tous deux sur localhost.
COOKIE_DOMAIN=

# Base de développement : soit le conteneur Docker (npm run db:up), soit une base PostgreSQL locale
POSTGRES_USER=okoume
POSTGRES_PASSWORD=changer-ce-mot-de-passe
POSTGRES_DB=okoume_dev
DATABASE_URL=postgresql://okoume:changer-ce-mot-de-passe@localhost:5433/okoume_dev

# Neon (staging, production) : deux adresses fournies par la console Neon
# DATABASE_URL=postgresql://<utilisateur>:<mot-de-passe>@<projet>-pooler.<region>.aws.neon.tech/<base>?sslmode=require
# DIRECT_DATABASE_URL=postgresql://<utilisateur>:<mot-de-passe>@<projet>.<region>.aws.neon.tech/<base>?sslmode=require

# Supervision des erreurs (Sentry > Project Settings > Client Keys). Vide : aucune remontée (développement)
SENTRY_DSN=
