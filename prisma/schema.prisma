// SchÃ©ma de la base de la boutique. Les modÃ¨les mÃ©tier sont ajoutÃ©s fonctionnalitÃ© par fonctionnalitÃ©,
// chacun avec sa migration versionnÃ©e. Dates en UTC, identifiants UUID (pas d'auto-incrÃ©ment qui rÃ©vÃ¨le le volume).

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------- Comptes clients

enum CustomerStatus {
  active
  anonymized
}

model Customer {
  id              String         @id @default(uuid()) @db.Uuid
  /// Toujours enregistrÃ© en minuscules
  email           String         @unique
  /// 8 derniers chiffres du numÃ©ro gabonais, pour retrouver un compte par tÃ©lÃ©phone
  phoneKey        String?        @unique @map("phone_key")
  phone           String?
  passwordHash    String         @map("password_hash")
  firstName       String         @map("first_name")
  lastName        String         @map("last_name")
  status          CustomerStatus @default(active)
  lastLoginAt     DateTime?      @map("last_login_at")
  /// PrÃ©fÃ©rences de notification par sujet et par canal : { "orders": { "push": false }, ... } (26)
  /// Date de lâ€™anonymisation (19.5) : le compte ne permet plus dâ€™identifier la personne
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  sessions  Session[]
  orders    Order[]
  shop      Shop?
  addresses CustomerAddress[]
  reviews   ProductReview[]

  @@index([status, lastLoginAt])
  @@map("customers")
}

// ---------------------------------------------------------------- Ã‰quipe et droits

enum StaffStatus {
  invited
  active
  suspended
}

model StaffMember {
  id                String      @id @default(uuid()) @db.Uuid
  email             String      @unique
  /// Absent tant que l'invitation n'est pas acceptÃ©e
  passwordHash      String?     @map("password_hash")
  firstName         String      @map("first_name")
  lastName          String      @map("last_name")
  /// RÃ´le unique de l'Ã©quipe back-office
  role              String      @default("super_admin")
  status            StaffStatus @default(invited)
  /// Toute session ouverte avant cette date est refusÃ©e
  sessionsRevokedAt DateTime?   @map("sessions_revoked_at")
  inviteTokenHash   String?     @unique @map("invite_token_hash")
  inviteExpiresAt   DateTime?   @map("invite_expires_at")
  lastLoginAt       DateTime?   @map("last_login_at")
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")

  sessions       Session[]
  stockMovements StockMovement[]
  priceChanges   PriceChange[]
  orderEvents    OrderEvent[]
  payments       Payment[]
  suspendedShops Shop[]          @relation("ShopSuspendedBy")
  verifiedShops  Shop[]          @relation("ShopVerifiedBy")
  sellerPayouts  SellerPayout[]

  @@map("staff_members")
}

enum LoginSubject {
  customer
  staff
}

model Session {
  id         String    @id @default(uuid()) @db.Uuid
  familyId   String    @map("family_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  customerId String?   @map("customer_id") @db.Uuid
  staffId    String?   @map("staff_id") @db.Uuid
  expiresAt  DateTime  @map("expires_at")
  usedAt     DateTime? @map("used_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  customer Customer?    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  staff    StaffMember? @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@index([customerId])
  @@index([staffId])
  @@map("sessions")
}

/// Journal des connexions (conservÃ© 12 mois)
model LoginEvent {
  id          String       @id @default(uuid()) @db.Uuid
  subjectType LoginSubject @map("subject_type")
  subjectId   String?      @map("subject_id") @db.Uuid
  success     Boolean
  /// Motif d'Ã©chec, sans donnÃ©e sensible
  reason      String?
  createdAt   DateTime     @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([subjectType, subjectId])
  @@map("login_events")
}

// ---------------------------------------------------------------- Catalogue

enum ImageFit {
  cover
  contain
}

/// CatÃ©gorie de l'arborescence, ou collection transversale (isCollection) qui regroupe des catÃ©gories.
model Category {
  id           String   @id @default(uuid()) @db.Uuid
  slug         String   @unique
  name         String
  fullName     String?  @map("full_name")
  parentId     String?  @map("parent_id") @db.Uuid
  icon         String?
  image        String?
  imageFit     ImageFit @default(contain) @map("image_fit")
  position     Int      @default(0)
  isCollection Boolean  @default(false) @map("is_collection")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  parent     Category?           @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children   Category[]          @relation("CategoryTree")
  members    CollectionMember[]  @relation("CollectionMembers")
  memberOf   CollectionMember[]  @relation("CollectionMemberOf")
  products   Product[]
  promoCodes PromoCodeCategory[]

  @@index([parentId, position])
  @@map("categories")
}

model CollectionMember {
  collectionId String @map("collection_id") @db.Uuid
  categoryId   String @map("category_id") @db.Uuid

  collection Category @relation("CollectionMembers", fields: [collectionId], references: [id], onDelete: Cascade)
  category   Category @relation("CollectionMemberOf", fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([collectionId, categoryId])
  @@index([categoryId])
  @@map("collection_members")
}

enum ProductStatus {
  draft
  published
  archived
}

enum PromotionType {
  percent
  fixed
}

/// Prix TTC en francs CFA, sans dÃ©cimale. La promotion est portÃ©e par le produit et vaut pour toutes ses variantes.
model Product {
  id                String             @id @default(uuid()) @db.Uuid
  slug              String             @unique
  name              String
  sku               String             @unique
  categoryId        String             @map("category_id") @db.Uuid
  brand             String?
  shortDescription  String             @map("short_description")
  description       String[]
  /// Liste de { label, value }
  specs             Json               @default("[]")
  usageTips         String?            @map("usage_tips")
  vatRate           Decimal            @default(18) @map("vat_rate") @db.Decimal(5, 2)
  hsCode            String?            @map("hs_code")
  status            ProductStatus      @default(draft)
  featured          Boolean            @default(false)
  dealOfTheDay      Boolean            @default(false) @map("deal_of_the_day")
  isNew             Boolean            @default(false) @map("is_new")
  tags              String[]
  promotionType     PromotionType?     @map("promotion_type")
  promotionValue    Decimal?           @map("promotion_value") @db.Decimal(12, 0)
  promotionStartsAt DateTime?          @map("promotion_starts_at")
  promotionEndsAt   DateTime?          @map("promotion_ends_at")
  /// Boutique du vendeur (32.3) ; vide pour un produit de la boutique OKOZA
  shopId            String?            @map("shop_id") @db.Uuid
  condition         ListingCondition?
  /// Ã‰tat d'un produit de vendeur (32.3) ; neuf pour la boutique OKOZA, renseignÃ© par le vendeur sinon
  /// VÃ©rification d'un produit de vendeur avant publication (32.3) ; vide pour la boutique OKOZA
  moderation        ProductModeration?
  moderationIssues  String[]           @default([]) @map("moderation_issues")
  moderationNote    String?            @map("moderation_note")
  /// Version examinÃ©e : un avis rendu sur une version modifiÃ©e depuis est ignorÃ©
  moderationVersion Int                @default(0) @map("moderation_version")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  category   Category           @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  shop       Shop?              @relation(fields: [shopId], references: [id], onDelete: Restrict)
  images     ProductImage[]
  variants   Variant[]
  promoCodes PromoCodeProduct[]
  reviews    ProductReview[]
  offers     ExclusiveOffer[]

  @@index([status, categoryId])
  @@index([status, createdAt])
  @@index([shopId, status])
  @@index([moderation])
  @@map("products")
}

/// Photos d'un produit dans l'ordre d'affichage ; la premiÃ¨re sert de vignette.
model ProductImage {
  id        String @id @default(uuid()) @db.Uuid
  productId String @map("product_id") @db.Uuid
  url       String
  alt       String @default("")
  position  Int

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, position])
  @@map("product_images")
}

/// Variante vendue. Disponible Ã  la vente : stock moins reserved. Le stock non revendable est Ã  part, jamais vendu.
model Variant {
  id                String   @id @default(uuid()) @db.Uuid
  productId         String   @map("product_id") @db.Uuid
  sku               String   @unique
  label             String
  /// Attributs de la variante, par exemple { Taille: M, Couleur: Bleu }
  attributes        Json     @default("{}")
  price             Decimal  @db.Decimal(12, 0)
  /// CoÃ»t d'achat, donnÃ©e interne jamais exposÃ©e au public ; obligatoire pour publier (28.1)
  cost              Decimal? @db.Decimal(12, 0)
  stock             Int      @default(0)
  reserved          Int      @default(0)
  unsellable        Int      @default(0)
  lowStockThreshold Int      @default(3) @map("low_stock_threshold")
  image             String?
  weightGrams       Int?     @map("weight_grams")
  position          Int      @default(0)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  stockMovements StockMovement[]
  priceChanges   PriceChange[]
  orderItems     OrderItem[]

  @@index([productId, position])
  @@map("variants")
}

enum StockMovementType {
  reception
  ajustement
  commande
}

/// Journal de chaque changement du stock physique : avant, aprÃ¨s, motif, auteur.
model StockMovement {
  id        String            @id @default(uuid()) @db.Uuid
  variantId String            @map("variant_id") @db.Uuid
  type      StockMovementType
  before    Int
  after     Int
  delta     Int
  reason    String
  orderId   String?           @map("order_id") @db.Uuid
  staffId   String?           @map("staff_id") @db.Uuid
  createdAt DateTime          @default(now()) @map("created_at")

  variant Variant      @relation(fields: [variantId], references: [id], onDelete: Restrict)
  order   Order?       @relation(fields: [orderId], references: [id], onDelete: SetNull)
  staff   StaffMember? @relation(fields: [staffId], references: [id], onDelete: SetNull)

  @@index([variantId, createdAt])
  @@map("stock_movements")
}

/// Historique des prix (4.3) : chaque changement de prix de vente, avec son motif et son auteur
model PriceChange {
  id        String   @id @default(uuid()) @db.Uuid
  variantId String   @map("variant_id") @db.Uuid
  before    Int
  after     Int
  reason    String
  staffId   String?  @map("staff_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  variant Variant      @relation(fields: [variantId], references: [id], onDelete: Cascade)
  staff   StaffMember? @relation(fields: [staffId], references: [id], onDelete: SetNull)

  @@index([variantId, createdAt])
  @@index([createdAt])
  @@map("price_changes")
}

// ---------------------------------------------------------------- Livraison

model DeliveryZone {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  city        String
  fee         Decimal  @db.Decimal(12, 0)
  eta         String
  days        String
  available   Boolean  @default(true)
  courierCost Decimal? @map("courier_cost") @db.Decimal(12, 0)
  position    Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  orders    Order[]
  couriers  CourierZone[]
  addresses CustomerAddress[]
  shopFees  ShopZoneFee[]

  @@unique([city, name])
  @@map("delivery_zones")
}

// ---------------------------------------------------------------- Commandes

enum OrderStatus {
  confirmed
  preparing
  ready
  courier_assigned
  shipping
  delivered
}

enum PaymentStatus {
  awaiting_payment
  paid
}

/// VÃ©rification humaine d'une commande signalÃ©e par les rÃ¨gles anti-fraude (19.3)
enum PaymentMethod {
  cash
  airtel
  moov
}

/// Commande : prix, frais et coordonnÃ©es figÃ©s au moment de l'achat. Montants TTC en francs CFA.
model Order {
  id                    String        @id @default(uuid()) @db.Uuid
  number                String        @unique
  trackingCode          String        @map("tracking_code")
  customerId            String?       @map("customer_id") @db.Uuid
  /// ClÃ© envoyÃ©e par le client : un double envoi renvoie la mÃªme commande
  idempotencyKey        String        @unique @map("idempotency_key")
  recipient             String
  phone                 String
  /// 8 derniers chiffres du tÃ©lÃ©phone : rapproche les commandes d'un mÃªme numÃ©ro, quelle que soit sa saisie
  email                 String
  zoneId                String        @map("zone_id") @db.Uuid
  zoneName              String        @map("zone_name")
  landmark              String
  /// Consignes pour le livreur saisies Ã  la commande (Ã©tage, portail, horaires)
  instructions          String        @default("")
  subtotal              Decimal       @db.Decimal(12, 0)
  productDiscount       Decimal       @default(0) @map("product_discount") @db.Decimal(12, 0)
  codeDiscount          Decimal       @default(0) @map("code_discount") @db.Decimal(12, 0)
  deliveryFee           Decimal       @map("delivery_fee") @db.Decimal(12, 0)
  deliveryDiscount      Decimal       @default(0) @map("delivery_discount") @db.Decimal(12, 0)
  total                 Decimal       @db.Decimal(12, 0)
  promoCode             String?       @map("promo_code")
  promoCodeId           String?       @map("promo_code_id") @db.Uuid
  /// Livreur affectÃ© (9.4)
  courierId             String?       @map("courier_id") @db.Uuid
  /// CoÃ»t rÃ©el de la course pour la boutique, distinct des frais facturÃ©s au client (9.5)
  deliveryCost          Decimal?      @map("delivery_cost") @db.Decimal(12, 0)
  paymentMethod         PaymentMethod @map("payment_method")
  paymentStatus         PaymentStatus @map("payment_status")
  /// InutilisÃ©es depuis le paiement Ã  la livraison pour tous les moyens (ancienne dÃ©claration par le client)
  status                OrderStatus   @default(confirmed)
  /// Boutique du vendeur qui reÃ§oit la commande (32.4) ; vide pour la boutique OKOZA
  shopId                String?       @map("shop_id") @db.Uuid
  /// Passage en caisse commun aux commandes issues d'un mÃªme panier (une commande par boutique)
  checkoutNumber        String?       @map("checkout_number")
  /// Qui livre, figÃ© Ã  la commande (32.5) : les livreurs OKOZA ou ceux du vendeur
  fulfilledBy           Fulfillment   @default(okoza) @map("fulfilled_by")
  /// Confirmation de remise de ce lot au livreur central.
  collectionConfirmedAt DateTime?     @map("collection_confirmed_at")
  collectionConfirmedBy String?       @map("collection_confirmed_by")
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")

  customer       Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  zone           DeliveryZone    @relation(fields: [zoneId], references: [id], onDelete: Restrict)
  promo          PromoCode?      @relation(fields: [promoCodeId], references: [id], onDelete: Restrict)
  items          OrderItem[]
  events         OrderEvent[]
  payments       Payment[]
  courier        Courier?        @relation(fields: [courierId], references: [id], onDelete: Restrict)
  shop           Shop?           @relation(fields: [shopId], references: [id], onDelete: Restrict)
  payout         SellerPayout?
  stockMovements StockMovement[]

  /// Signaux anti-fraude levÃ©s Ã  la crÃ©ation ; la prÃ©paration attend la vÃ©rification d'un membre de l'Ã©quipe

  @@index([customerId, createdAt])
  @@index([status, createdAt])
  @@index([shopId, status, createdAt])
  @@index([checkoutNumber])
  @@map("orders")
}

model OrderItem {
  id            String  @id @default(uuid()) @db.Uuid
  orderId       String  @map("order_id") @db.Uuid
  productId     String  @map("product_id") @db.Uuid
  variantId     String  @map("variant_id") @db.Uuid
  name          String
  variantLabel  String  @map("variant_label")
  image         String
  unitPrice     Decimal @map("unit_price") @db.Decimal(12, 0)
  originalPrice Decimal @map("original_price") @db.Decimal(12, 0)
  vatRate       Decimal @map("vat_rate") @db.Decimal(5, 2)
  quantity      Int

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant Variant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([variantId])
  @@map("order_items")
}

enum OrderActor {
  customer
  staff
  system
  /// Vendeur de la boutique qui a reÃ§u la commande (32.4)
  seller
}

/// Ã‰tapes de la commande : nouvel Ã©tat, Ã©tat prÃ©cÃ©dent, auteur, motif.
model OrderEvent {
  id         String       @id @default(uuid()) @db.Uuid
  orderId    String       @map("order_id") @db.Uuid
  status     OrderStatus
  fromStatus OrderStatus? @map("from_status")
  note       String?
  actor      OrderActor
  staffId    String?      @map("staff_id") @db.Uuid
  createdAt  DateTime     @default(now()) @map("created_at")

  order Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  staff StaffMember? @relation(fields: [staffId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
  @@map("order_events")
}


enum PaymentKind {
  payment
}

model Payment {
  id         String        @id @default(uuid()) @db.Uuid
  orderId    String        @map("order_id") @db.Uuid
  kind       PaymentKind
  amount     Decimal       @db.Decimal(12, 0)
  method     PaymentMethod
  occurredAt DateTime      @map("occurred_at")
  /// RÃ©fÃ©rence de la transaction ; unique parmi les encaissements (index partiel dans la migration)
  reference  String?
  /// null : encaissement dÃ©clarÃ© par le vendeur qui a livrÃ© lui-mÃªme (32.6)
  staffId    String?       @map("staff_id") @db.Uuid
  createdAt  DateTime      @default(now()) @map("created_at")

  order Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  staff StaffMember? @relation(fields: [staffId], references: [id], onDelete: Restrict)

  @@index([orderId, createdAt])
  @@map("payments")
}


// ---------------------------------------------------------------- Codes promo

/// Code promotionnel (cahier des charges, 11.2). Code stockÃ© en majuscules ; un seul code par commande.
model PromoCode {
  id           String        @id @default(uuid()) @db.Uuid
  code         String        @unique
  label        String
  type         PromotionType
  value        Decimal       @db.Decimal(12, 0)
  minAmount    Decimal       @default(0) @map("min_amount") @db.Decimal(12, 0)
  freeDelivery Boolean       @default(false) @map("free_delivery")
  /// Niveaux de fidÃ©litÃ© autorisÃ©s ; vide : tous les clients
  startsAt     DateTime      @map("starts_at")
  endsAt       DateTime      @map("ends_at")
  /// Limite totale ; null : sans limite
  maxUses      Int?          @map("max_uses")
  /// Limite par client ; null : sans limite
  /// Commandes non annulÃ©es qui utilisent le code, tenu Ã  jour dans la transaction de commande
  uses         Int           @default(0)
  active       Boolean       @default(true)
  /// Code personnel : utilisable seulement par ce client
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  products   PromoCodeProduct[]
  categories PromoCodeCategory[]
  orders     Order[]

  @@map("promo_codes")
}

model PromoCodeProduct {
  promoCodeId String @map("promo_code_id") @db.Uuid
  productId   String @map("product_id") @db.Uuid

  promoCode PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([promoCodeId, productId])
  @@map("promo_code_products")
}

model PromoCodeCategory {
  promoCodeId String @map("promo_code_id") @db.Uuid
  categoryId  String @map("category_id") @db.Uuid

  promoCode PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)
  category  Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([promoCodeId, categoryId])
  @@map("promo_code_categories")
}


/// RÃ©glages de la boutique, une seule ligne (id = 1), modifiables par l'administrateur principal.
model ShopSettings {
  id           Int      @id @default(1)
  maxAddresses Int      @default(5) @map("max_addresses")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("shop_settings")
}


/// Compteur d'une sÃ©rie de documents (type et annÃ©e) : numÃ©rotation continue, attribuÃ©e dans une transaction.

/// Archive comptable conservÃ©e 10 ans (19.5) : aucune clÃ© vers le compte client, qui peut Ãªtre anonymisÃ©.

// ---------------------------------------------------------------- Livreurs

enum CourierVehicle {
  moto
  voiture
  velo
  a_pied
}

/// Livreur du rÃ©pertoire (9.3) : identification et contact, sans compte sur la plateforme.
model Courier {
  id        String         @id @default(uuid()) @db.Uuid
  firstName String         @map("first_name")
  lastName  String         @map("last_name")
  phone     String
  email     String?
  vehicle   CourierVehicle
  active    Boolean        @default(true)
  notes     String         @default("")
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  zones  CourierZone[]
  orders Order[]

  @@map("couriers")
}

model CourierZone {
  courierId String @map("courier_id") @db.Uuid
  zoneId    String @map("zone_id") @db.Uuid

  courier Courier      @relation(fields: [courierId], references: [id], onDelete: Cascade)
  zone    DeliveryZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@id([courierId, zoneId])
  @@index([zoneId])
  @@map("courier_zones")
}

/// Changement des frais facturÃ©s aprÃ¨s la commande (9.5) : appliquÃ© seulement avec l'accord du client.

/// Contestation d'une livraison marquÃ©e Â« LivrÃ©e Â» (9.6) : la commande garde son statut pendant l'enquÃªte.




// ---------------------------------------------------------------- Notifications push

/// Appareil abonnÃ© aux notifications push (10.2, 26) : client ou membre de l'Ã©quipe, jamais les deux.

/// Notification dÃ©jÃ  remise Ã  un appareil : une reprise du traitement ne la renvoie pas (10.4).

// Place de marchÃ© hybride (cahier des charges, section 32) : boutiques de vendeurs tiers et offres d'accÃ¨s

enum ShopStatus {
  active
  suspended
}

/// Boutique d'un vendeur tiers (32.2) : une par compte client.
model Shop {
  id                     String          @id @default(uuid()) @db.Uuid
  ownerId                String          @unique @map("owner_id") @db.Uuid
  slug                   String          @unique
  name                   String
  description            String          @default("")
  city                   String
  district               String
  /// Position de la boutique, pour le tri par proximitÃ© (32.4) ; jamais affichÃ©e telle quelle
  latitude               Decimal?        @db.Decimal(8, 6)
  longitude              Decimal?        @db.Decimal(9, 6)
  phone                  String
  /// Fin de la pÃ©riode en cours (essai ou pÃ©riode payÃ©e) ; null pour une offre gratuite ou en attente de paiement
  status                 ShopStatus      @default(active)
  suspensionReason       String?         @map("suspension_reason")
  suspendedAt            DateTime?       @map("suspended_at")
  suspendedById          String?         @map("suspended_by_id") @db.Uuid
  verifiedAt             DateTime?       @map("verified_at")
